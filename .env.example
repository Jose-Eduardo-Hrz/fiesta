# ─────────────────────────────────────────────────────────────
#  Baby Shower de Azul Alejandra — variables de entorno
#  Copia este archivo como .env y rellena los valores.
#  NUNCA subas el archivo .env a un repositorio.
# ─────────────────────────────────────────────────────────────

# Credenciales del panel /admin (obligatorias para entrar al panel)
ADMIN_USERNAME=anfitrion
ADMIN_PASSWORD=cambia-esta-contrasena-por-una-larga

# Secreto para firmar la sesión del anfitrión y los tokens de subida.
# Mínimo 32 caracteres aleatorios. Puedes generarlo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Carpeta donde se guardan fotos y videos (estructura archivos/mesa-N/Invitado/)
STORAGE_DIR=./archivos

# Archivo de la base de datos SQLite
DATABASE_PATH=./data/baby-shower.db

# ── Solo producción (adapter-node) ──────────────────────────
# URL pública exacta del sitio (necesaria para la protección CSRF de SvelteKit)
# OBLIGATORIA en producción (sin ella falla el login del panel):
ORIGIN=http://localhost:3000
# Sin esto adapter-node rechaza cuerpos > 512 KB. El endpoint de subida
# aplica sus propios límites (ver src/lib/config.ts), así que es seguro.
BODY_SIZE_LIMIT=Infinity
# PORT=3000
# HOST=0.0.0.0
# Si hay un proxy (nginx, Caddy) delante, para obtener la IP real:
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
